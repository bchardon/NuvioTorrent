+package com.nuvio.app.features.streams
+
+import com.nuvio.app.features.p2p.TorrentSources
+import kotlin.test.*
+
+class TorrentSourceStreamTest {
+    @Test fun metadataSourceIsPlayableWithoutAnInfoHash() {
+        val payload = """{"streams":[{"name":"Example","torrent":{"url":"https://example.org/download?key=dummy","season":1,"episode":2}}]}"""
+        val stream = StreamParser.parse(payload, "Example", "addon:example").single()
+        assertTrue(stream.isTorrentStream)
+        assertTrue(stream.needsLocalDebridResolve)
+        assertFalse(stream.isAddonDebridCandidate)
+        assertNull(stream.playableDirectUrl)
+        assertTrue(TorrentSources.isReference(stream.p2pInfoHash))
+        assertFalse(stream.toString().contains("dummy"))
+    }
+
+    @Test fun legacyStreamsKeepTheirRouting() {
+        val payload = """{"streams":[{"url":"https://example.org/movie.mp4"},{"infoHash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}"""
+        val streams = StreamParser.parse(payload, "Example", "addon:example")
+        assertEquals("https://example.org/movie.mp4", streams[0].playableDirectUrl)
+        assertFalse(streams[0].isTorrentStream)
+        assertTrue(streams[1].isTorrentStream)
+        assertEquals("a".repeat(40), streams[1].p2pInfoHash)
+    }
+}
