+package com.nuvio.tv.core.torrent
+
+import com.nuvio.tv.data.mapper.toDomain
+import com.nuvio.tv.data.remote.dto.StreamResponseDto
+import com.squareup.moshi.Moshi
+import org.junit.Assert.*
+import org.junit.Test
+
+class TorrentSourceStreamTest {
+    @Test fun `HTTP addon metadata source is playable without a URL or hash`() {
+        val payload = """{"streams":[{"name":"Example","torrent":{"url":"https://example.org/download?key=dummy","season":1,"episode":2}}]}"""
+        val dto = Moshi.Builder().build().adapter(StreamResponseDto::class.java).fromJson(payload)!!.streams!!.single()
+        val stream = dto.toDomain("Example", null)
+        assertTrue(stream.isTorrent())
+        assertFalse(stream.isExternal())
+        assertNull(stream.getStreamUrl())
+        assertTrue(TorrentSources.isReference(stream.getEffectiveInfoHash()))
+        assertFalse(stream.toString().contains("dummy"))
+    }
+
+    @Test fun `legacy HTTP and hash sources keep their routing`() {
+        val payload = """{"streams":[{"url":"https://example.org/movie.mp4"},{"infoHash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}"""
+        val streams = Moshi.Builder().build().adapter(StreamResponseDto::class.java).fromJson(payload)!!.streams!!.map { it.toDomain("Example", null) }
+        assertFalse(streams[0].isTorrent())
+        assertEquals("https://example.org/movie.mp4", streams[0].getStreamUrl())
+        assertTrue(streams[1].isTorrent())
+        assertEquals("a".repeat(40), streams[1].getEffectiveInfoHash())
+    }
+}
