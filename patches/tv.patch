+package com.nuvio.tv.core.torrent
+
+import java.util.Base64
+import java.util.concurrent.TimeUnit
+import kotlinx.coroutines.runBlocking
+import okhttp3.mockwebserver.MockResponse
+import okhttp3.mockwebserver.MockWebServer
+import okio.Buffer
+import org.junit.Assert.*
+import org.junit.Test
+
+class TorrentMetadataTest {
+    @Test fun `resolution happens after selection and preserves selectors`() = runBlocking<Unit> {
+        var calls = 0
+        val url = TorrentSources.register(TorrentSource(resolveId = "source-1", season = 1, episode = 2)) { id ->
+            assertEquals("source-1", id)
+            calls++
+            TorrentSource(dataBase64 = "ZGU=")
+        }
+        assertEquals(0, calls)
+        assertFalse(url.contains("source-1"))
+        val result = TorrentSources.resolve(requireNotNull(TorrentSources.referenceFromUrl(url)))
+        assertEquals(1, calls)
+        assertEquals(2, result.episode)
+        assertEquals(1, result.season)
+    }
+
+    @Test fun `private torrent bytes are never decoded or reconstructed`() = runBlocking<Unit> {
+        val tracker = "https://tracker.invalid/passkey/announce"
+        val bytes = ("d8:announce${tracker.length}:$tracker" +
+            "4:infod6:lengthi4e4:name9:movie.mkv12:piece lengthi16384e6:pieces20:").toByteArray() +
+            ByteArray(20) { index -> if (index % 2 == 0) 0x80.toByte() else 0xff.toByte() } +
+            "7:privatei1eee".toByteArray()
+        MockWebServer().use { server ->
+            server.enqueue(MockResponse().setBody(Buffer().write(bytes)))
+            val source = TorrentSource(url = server.url("/download?apikey=secret").toString())
+            assertArrayEquals(bytes, TorrentMetadataLoader.load(source))
+            assertEquals("application/x-bittorrent", server.takeRequest().getHeader("Accept"))
+            assertFalse(source.toString().contains("secret"))
+        }
+        assertArrayEquals(bytes, TorrentMetadataLoader.load(TorrentSource(dataBase64 = Base64.getEncoder().encodeToString(bytes))))
+    }
+
+    @Test fun `oversized streamed bodies fail instead of being truncated`() = runBlocking<Unit> {
+        MockWebServer().use { server ->
+            server.enqueue(MockResponse().setChunkedBody(Buffer().write(ByteArray(MAX_TORRENT_BYTES + 1)), 8192))
+            expectSourceError { TorrentMetadataLoader.load(TorrentSource(url = server.url("/large").toString())) }
+        }
+    }
+
+    @Test fun `authentication errors do not expose credentials or response bodies`() = runBlocking<Unit> {
+        MockWebServer().use { server ->
+            server.enqueue(MockResponse().setResponseCode(403).setBody("token=secret"))
+            val error = expectSourceError { TorrentMetadataLoader.load(TorrentSource(url = server.url("/secret").toString())) }
+            assertTrue("Expected an authentication error, got: ${error.message}", error.message!!.contains("authentication"))
+            // Coroutine stack-trace recovery may attach the original safe exception as a cause.
+            // Check the full diagnostic output, including causes, rather than requiring no cause.
+            assertFalse("Authentication diagnostics must not expose request or response data",
+                error.stackTraceToString().contains("secret"))
+            var current: Throwable? = error
+            repeat(32) {
+                val cause = current ?: return@repeat
+                assertTrue("Only sanitized torrent errors may be retained as causes", cause is TorrentSourceException)
+                current = cause.cause
+            }
+            assertNull("Unexpected cyclic or excessive exception chain", current)
+        }
+    }
+
+    @Test fun `redirects do not forward custom authentication to another origin`() = runBlocking<Unit> {
+        MockWebServer().use { origin ->
+            MockWebServer().use { target ->
+                target.enqueue(MockResponse().setBody("de"))
+                origin.enqueue(MockResponse().setResponseCode(302).setHeader("Location", target.url("/torrent")))
+                TorrentMetadataLoader.load(TorrentSource(url = origin.url("/download").toString(),
+                    headers = mapOf("Authorization" to "Bearer secret", "Cookie" to "session=secret", "X-Api-Key" to "secret")))
+                assertEquals("Bearer secret", origin.takeRequest().getHeader("Authorization"))
+                val request = target.takeRequest(5, TimeUnit.SECONDS)!!
+                assertNull(request.getHeader("Authorization"))
+                assertNull(request.getHeader("Cookie"))
+                assertNull(request.getHeader("X-Api-Key"))
+            }
+        }
+    }
+
+    @Test fun `malformed and empty base64 fail without leaking the value`() = runBlocking<Unit> {
+        expectSourceError { TorrentMetadataLoader.load(TorrentSource(dataBase64 = "passkey!")) }
+        expectSourceError { TorrentMetadataLoader.load(TorrentSource(dataBase64 = "")) }
+    }
+
+    @Test fun `episode selection preserves original indices and avoids episode twenty`() {
+        val files = listOf(TorrentMetadataFile(0, "cover.jpg", 20),
+            TorrentMetadataFile(1, "Show.S01E20.mkv", 3000),
+            TorrentMetadataFile(2, "Show.S01E02.mkv", 2000),
+            TorrentMetadataFile(3, "Show.S01E01.mkv", 4000))
+        assertEquals(2, selectMetadataFile(files, TorrentSource(url = "https://example.org/torrent", season = 1, episode = 2), null))
+        assertThrows(TorrentSourceException::class.java) {
+            selectMetadataFile(files, TorrentSource(url = "https://example.org/torrent", season = 2, episode = 2), null)
+        }
+        assertThrows(TorrentSourceException::class.java) {
+            selectMetadataFile(files, TorrentSource(url = "https://example.org/torrent", fileIdx = 99), null)
+        }
+        assertThrows(TorrentSourceException::class.java) {
+            selectMetadataFile(files, TorrentSource(url = "https://example.org/torrent", fileIdx = 0), null)
+        }
+    }
+
+    @Test fun `movie selection ignores samples and honors explicit file indices`() {
+        val files = listOf(TorrentMetadataFile(0, "sample.mkv", 5000), TorrentMetadataFile(4, "movie.mkv", 2000))
+        assertEquals(4, selectMetadataFile(files, TorrentSource(url = "https://example.org/torrent"), null))
+        assertEquals(0, selectMetadataFile(files, TorrentSource(url = "https://example.org/torrent", fileIdx = 0), null))
+        assertEquals(0, selectMetadataFile(files, TorrentSource(url = "https://example.org/torrent", fileIdx = 0, filename = "movie.mkv"), null))
+        assertThrows(TorrentSourceException::class.java) {
+            selectMetadataFile(files, TorrentSource(url = "https://example.org/torrent", filename = "missing.mkv"), null)
+        }
+    }
+
+    private suspend fun expectSourceError(block: suspend () -> Unit): TorrentSourceException {
+        try { block() } catch (error: TorrentSourceException) { return error }
+        throw AssertionError("Expected a safe torrent metadata error")
+    }
+}
