@@ -0,0 +1,111 @@
+package com.nuvio.tv.core.torrent
+
+import java.io.ByteArrayOutputStream
+import java.io.IOException
+import java.util.Base64
+import kotlin.coroutines.resume
+import kotlin.coroutines.resumeWithException
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.withTimeout
+import okhttp3.Call
+import okhttp3.Callback
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.Response
+import java.util.concurrent.TimeUnit
+
+/** Fetch only after selection; never reinterpret torrent metadata as UTF-8. */
+object TorrentMetadataLoader {
+    private val client = OkHttpClient.Builder()
+        .followRedirects(false).followSslRedirects(false)
+        .callTimeout(30, TimeUnit.SECONDS).build()
+
+    suspend fun load(source: TorrentSource): ByteArray = try {
+        source.validate(allowResolver = false)
+        val bytes = if (source.dataBase64 != null) {
+            Base64.getDecoder().decode(source.dataBase64)
+        } else {
+            download(requireNotNull(source.url), source.headers)
+        }
+        require(bytes.isNotEmpty() && bytes.size <= MAX_TORRENT_BYTES) { "Invalid torrent size" }
+        bytes
+    } catch (_: TimeoutCancellationException) {
+        throw TorrentSourceException("Torrent metadata download timed out; try again")
+    } catch (cancelled: CancellationException) {
+        throw cancelled
+    } catch (error: TorrentSourceException) {
+        throw error
+    } catch (_: Exception) {
+        throw TorrentSourceException("Invalid or unavailable torrent metadata (maximum 4 MiB)")
+    }
+
+    private suspend fun download(rawUrl: String, headers: Map<String, String>): ByteArray = withTimeout(60_000L) {
+        val origin = rawUrl.toHttpUrlOrNull() ?: error("Invalid torrent URL")
+        require(origin.username.isEmpty() && origin.password.isEmpty())
+        var url = origin
+        repeat(6) {
+            val request = Request.Builder().url(url).header("Accept", "application/x-bittorrent").apply {
+                // Custom cookies/headers must not follow a redirect to another origin.
+                if (url.scheme == origin.scheme && url.host == origin.host && url.port == origin.port) {
+                    headers.forEach { (key, value) -> header(key, value) }
+                }
+            }.build()
+            val result = read(client.newCall(request))
+            if (result.redirect == null) return@withTimeout result.bytes
+            val redirected = url.resolve(result.redirect) ?: error("Invalid torrent redirect")
+            require(redirected.username.isEmpty() && redirected.password.isEmpty())
+            require(url.scheme != "https" || redirected.scheme == "https")
+            url = redirected
+        }
+        throw TorrentSourceException("Too many redirects while resolving torrent metadata")
+    }
+
+    private data class ReadResult(val bytes: ByteArray = byteArrayOf(), val redirect: String? = null)
+
+    private suspend fun read(call: Call): ReadResult = suspendCancellableCoroutine { continuation ->
+        continuation.invokeOnCancellation { call.cancel() }
+        call.enqueue(object : Callback {
+            override fun onFailure(call: Call, e: IOException) {
+                if (continuation.isActive) continuation.resumeWithException(
+                    TorrentSourceException("Torrent download failed; refresh the source or sign in again")
+                )
+            }
+
+            override fun onResponse(call: Call, response: Response) {
+                try {
+                    val result = response.use {
+                        if (it.code in listOf(301, 302, 303, 307, 308)) {
+                            ReadResult(redirect = it.header("Location") ?: error("Missing redirect"))
+                        } else {
+                            if (it.code == 401 || it.code == 403) {
+                                throw TorrentSourceException("Torrent authentication failed or expired; sign in again")
+                            }
+                            require(it.isSuccessful)
+                            val body = requireNotNull(it.body)
+                            require(body.contentLength() <= MAX_TORRENT_BYTES)
+                            val output = ByteArrayOutputStream()
+                            body.byteStream().use { stream ->
+                                val buffer = ByteArray(8192)
+                                while (true) {
+                                    val count = stream.read(buffer)
+                                    if (count < 0) break
+                                    require(output.size() + count <= MAX_TORRENT_BYTES)
+                                    output.write(buffer, 0, count)
+                                }
+                            }
+                            ReadResult(output.toByteArray())
+                        }
+                    }
+                    if (continuation.isActive) continuation.resume(result)
+                } catch (error: Exception) {
+                    if (continuation.isActive) continuation.resumeWithException(
+                        error as? TorrentSourceException ?: TorrentSourceException("Invalid torrent response (maximum 4 MiB)")
+                    )
+                }
+            }
+        })
+    }
+}
diff --git a/app/src/main/java/com/nuvio/tv/core/torrent/TorrentSources.kt b/app/src/main/java/com/nuvio/tv/core/torrent/TorrentSources.kt
new file mode 100644
index 0000000..f186ba7
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/core/torrent/TorrentSources.kt
@@ -0,0 +1,129 @@
+package com.nuvio.tv.core.torrent
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.withTimeout
+import kotlin.uuid.ExperimentalUuidApi
+import kotlin.uuid.Uuid
+
+/** Optional wire contract shared by JS providers and HTTP add-ons. Never persist this object. */
+data class TorrentSource(
+    val url: String? = null,
+    val dataBase64: String? = null,
+    val headers: Map<String, String> = emptyMap(),
+    val resolveId: String? = null,
+    val fileIdx: Int? = null,
+    val filename: String? = null,
+    val season: Int? = null,
+    val episode: Int? = null,
+) {
+    fun validate(allowResolver: Boolean = true) {
+        require(listOf(url, dataBase64, resolveId).count { !it.isNullOrBlank() } == 1) {
+            "A torrent source must contain exactly one URL, dataBase64 or resolveId"
+        }
+        require(allowResolver || resolveId == null) { "Recursive torrent resolution is not supported" }
+        require(fileIdx == null || fileIdx >= 0) { "Invalid torrent file index" }
+        require((season == null) == (episode == null) && (season == null || season >= 0) &&
+            (episode == null || episode >= 0)) { "Invalid torrent episode selector" }
+        require(url == null || (url.length <= 16_384 &&
+            (url.startsWith("https://") || url.startsWith("http://")))) { "Invalid torrent URL" }
+        require(dataBase64 == null || dataBase64.length <= MAX_TORRENT_BASE64_CHARS) {
+            "Torrent metadata exceeds the 4 MiB limit"
+        }
+        require(resolveId == null || resolveId.length <= 16_384) { "Torrent reference is too large" }
+        require(headers.size <= 64 && headers.all { (key, value) ->
+            key.isNotBlank() && key.length <= 256 && value.length <= 8192 &&
+                '\r' !in key && '\n' !in key && '\r' !in value && '\n' !in value
+        }) { "Invalid torrent request headers" }
+    }
+
+    // URLs, tokens, passkeys and bencoded metadata must never appear in a model log.
+    override fun toString(): String = "TorrentSource([redacted])"
+}
+
+const val MAX_TORRENT_BYTES = 4 * 1024 * 1024
+const val MAX_TORRENT_BASE64_CHARS = ((MAX_TORRENT_BYTES + 2) / 3) * 4
+
+/**
+ * Navigation uses an opaque process-local reference, never torrent bytes or authenticated URLs.
+ * Existing P2P routing carries this reference in its source/hash slot; the native loader explicitly
+ * distinguishes it from an info hash. References cannot be replayed after process death.
+ */
+object TorrentSources {
+    private const val PREFIX = "nuvio-torrent:"
+    private data class Entry(val cost: Int, val resolve: suspend () -> TorrentSource)
+    private val entries = MutableStateFlow<Map<String, Entry>>(emptyMap())
+
+    @OptIn(ExperimentalUuidApi::class)
+    fun register(source: TorrentSource, resolver: (suspend (String) -> TorrentSource)? = null): String {
+        source.validate()
+        require(source.resolveId == null || resolver != null) { "Torrent resolver is unavailable" }
+        val reference = PREFIX + Uuid.random().toString()
+        val entry = Entry(source.dataBase64?.length ?: 16_384) {
+            val resolved = source.resolveId?.let { resolver!!.invoke(it) } ?: source
+            resolved.validate(allowResolver = false)
+            resolved.copy(fileIdx = resolved.fileIdx ?: source.fileIdx, filename = resolved.filename ?: source.filename,
+                season = resolved.season ?: source.season, episode = resolved.episode ?: source.episode)
+        }
+        entries.update { previous ->
+            val next = previous.toMutableMap()
+            next[reference] = entry
+            var cost = next.values.sumOf { it.cost }
+            while (next.size > 512 || cost > 32 * 1024 * 1024) {
+                val oldest = next.keys.first()
+                cost -= next.remove(oldest)!!.cost
+            }
+            next
+        }
+        return "torrent://$reference"
+    }
+
+    fun isReference(value: String?): Boolean = value?.startsWith(PREFIX) == true
+
+    fun referenceFromUrl(value: String?): String? = value
+        ?.takeIf { it.startsWith("torrent://$PREFIX") }
+        ?.removePrefix("torrent://")?.substringBefore('?')?.substringBefore('/')
+
+    suspend fun resolve(reference: String): TorrentSource = try {
+        val entry = entries.value[reference] ?: error("Torrent source expired; refresh the stream list")
+        withTimeout(60_000L) { entry.resolve() }
+    } catch (_: TimeoutCancellationException) {
+        throw TorrentSourceException("Torrent metadata resolution timed out; try again")
+    } catch (cancelled: CancellationException) {
+        throw cancelled
+    } catch (error: TorrentSourceException) {
+        throw error
+    } catch (_: Exception) {
+        // A plugin or HTTP exception can contain a complete authenticated URL.
+        throw TorrentSourceException("Unable to resolve torrent metadata; refresh the source or sign in again")
+    }
+}
+
+class TorrentSourceException(message: String) : Exception(message)
+
+data class TorrentMetadataFile(val index: Int, val path: String, val size: Long)
+
+/** Never silently play another episode or fall back from an invalid explicit index. */
+fun selectMetadataFile(files: List<TorrentMetadataFile>, source: TorrentSource, fallbackIndex: Int?): Int {
+    val videos = files.filter { it.size > 0 && Regex("(?i)\\.(mkv|mp4|avi|mov|m4v|ts|m2ts|webm|mpeg|mpg|wmv|flv|vp8|ogv)$").containsMatchIn(it.path) }
+    val index = source.fileIdx ?: fallbackIndex
+    if (index != null) return videos.firstOrNull { it.index == index }?.index
+        ?: throw TorrentSourceException("The selected torrent file is missing or is not a video")
+    val episode = source.episode
+    val season = source.season
+    if (episode != null && season != null) {
+        val pattern = Regex("(?i)(?:^|[^a-z0-9])(?:s0*$season[ ._-]*e0*$episode|0*${season}x0*$episode|season[ ./_-]*0*$season[ ./_-]+(?:episode|ep)[ ._-]*0*$episode)(?:[^0-9]|$)")
+        return videos.filter { pattern.containsMatchIn(it.path) }.maxByOrNull { it.size }?.index
+            ?: throw TorrentSourceException("The requested episode is not present in this torrent")
+    }
+    source.filename?.let { filename ->
+        val exact = videos.filter { it.path.replace('\\', '/') == filename.replace('\\', '/') ||
+            it.path.substringAfterLast('/').substringAfterLast('\\') == filename }
+        return exact.singleOrNull()?.index
+            ?: throw TorrentSourceException("The requested torrent filename is missing or ambiguous")
+    }
+    return videos.filterNot { Regex("(?i)(?:^|[ /._-])sample(?:[ /._-]|$)").containsMatchIn(it.path) }
+        .maxByOrNull { it.size }?.index ?: throw TorrentSourceException("No playable video was found in this torrent")
+}
