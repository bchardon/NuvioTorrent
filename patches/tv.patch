@@ -0,0 +1,68 @@
+package com.nuvio.tv.core.torrent
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.nuvio.engine.NuvioEngine
+import com.nuvio.engine.NuvioEngineConfig
+import com.nuvio.engine.NuvioUploadMode
+import com.nuvio.tv.core.torrent.TorrentMetadataFile
+import com.nuvio.tv.core.torrent.TorrentSource
+import com.nuvio.tv.core.torrent.selectMetadataFile
+import java.io.File
+import java.security.MessageDigest
+import java.util.UUID
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/** Runs against the actual Android JNI library, without a provider account or real content. */
+@RunWith(AndroidJUnit4::class)
+class TorrentMetadataNativeTest {
+    @Test fun completePrivateMetadataImportsWithOriginalHashAndFileIndices() = runBlocking {
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        val root = File(context.cacheDir, "torrent-native-test/${UUID.randomUUID()}")
+        val engine = NuvioEngine.create(NuvioEngineConfig(
+            dataDirectory = File(root, "state"), cacheDirectory = File(root, "cache"),
+            memoryCacheCapacityBytes = 1024 * 1024, diskCacheCapacityBytes = 0,
+            uploadMode = NuvioUploadMode.Disabled,
+        ))
+        try {
+            val info = mapOf("name" to "season", "private" to 1, "piece length" to 16384,
+                "pieces" to ByteArray(20), "files" to listOf(
+                    mapOf("length" to 4, "path" to listOf("Example.S01E01.mkv")),
+                    mapOf("length" to 8, "path" to listOf("Example.S01E02.mkv"))
+                ))
+            val originalInfo = bencode(info)
+            val metadata = bencode(mapOf("announce" to "https://tracker.invalid/private/dummy/announce", "info" to info))
+            val id = withTimeout(15_000L) { engine.addTorrent(metadata) }
+            val expected = MessageDigest.getInstance("SHA-1").digest(originalInfo).joinToString("") { "%02x".format(it.toInt() and 0xff) }
+            assertEquals(expected, id)
+            val files = engine.files(id)
+            assertEquals(listOf(0, 1), files.map { it.index })
+            assertEquals(listOf(4L, 8L), files.map { it.size })
+            val selected = selectMetadataFile(files.map { TorrentMetadataFile(it.index, it.path, it.size) },
+                TorrentSource(dataBase64 = "ZGU=", season = 1, episode = 2), null)
+            assertEquals(1, selected)
+            val stream = withTimeout(15_000L) { engine.prepareStream(id, fileIndex = selected) }
+            assertEquals(1, stream.fileIndex)
+            assertEquals(8L, stream.fileSize)
+            assertTrue(stream.url.startsWith("http://127.0.0.1:"))
+            engine.stopStream(stream.id)
+        } finally {
+            engine.shutdown()
+        }
+    }
+
+    private fun bencode(value: Any): ByteArray = when (value) {
+        is ByteArray -> "${value.size}:".toByteArray() + value
+        is String -> bencode(value.toByteArray())
+        is Number -> "i${value.toLong()}e".toByteArray()
+        is List<*> -> "l".toByteArray() + value.fold(byteArrayOf()) { result, item -> result + bencode(requireNotNull(item)) } + "e".toByteArray()
+        is Map<*, *> -> "d".toByteArray() + value.entries.sortedBy { it.key.toString() }.fold(byteArrayOf()) { result, entry ->
+            result + bencode(entry.key.toString()) + bencode(requireNotNull(entry.value))
+        } + "e".toByteArray()
+        else -> error("Unsupported fixture value")
+    }
+}
